{
  "luci-app-dlink-cellular": {
    "description": "D-Link cellular signal and lock readback",
    "read": {
      "ubus": {
        "dlink-cellular": [
          "overview",
          "summary",
          "qos",
          "locks",
          "access"
        ],
        "network.interface.wan": [
          "status"
        ]
      }
    }
  },
  "luci-app-dlink-cellular-private": {
    "description": "Administer cellular SMS, diagnostics, and radio settings",
    "read": {
      "ubus": {
        "dlink-cellular": [
          "sms_list",
          "sms_read",
          "diag",
          "diag_checks",
          "capture_status",
          "engineering_info",
          "at_query",
          "mimo_info",
          "sim_status",
          "scan_status",
          "events_sms",
          "beam_info",
          "radio_policy",
          "sim_protection",
          "sdk_identity",
          "sdk_network",
          "sdk_radio",
          "plmn_scan_status",
          "smsc_get",
          "apn_get",
          "cf_query",
          "cw_query"
        ]
      }
    },
    "write": {
      "ubus": {
        "dlink-cellular": [
          "band_set",
          "cell_set",
          "cell_clear",
          "cell_list_set",
          "cell_list_clear",
          "sms_send",
          "sms_delete",
          "capture_start",
          "capture_stop",
          "wan_redial",
          "mimo_set",
          "scan_start",
          "scan_stop",
          "wifi_power_set",
          "radio_policy_set",
          "sim_action",
          "wifi_flag_set",
          "wan_auto_set",
          "airplane_set",
          "nwmode_set",
          "plmn_set",
          "plmn_scan_start",
          "smsc_set",
          "ussd_send",
          "apn_set",
          "cf_set",
          "cw_set"
        ]
      }
    }
  },
  "luci-app-dlink-cellular-voice": {
    "description": "View SIM calls and explicitly place, answer, end, or send in-call tones",
    "read": {
      "ubus": {
        "dlink-cellular": [
          "voice_status"
        ]
      }
    },
    "write": {
      "ubus": {
        "dlink-cellular": [
          "voice_dial",
          "voice_answer",
          "voice_hangup",
          "voice_dtmf"
        ],
        "dlink-media": [
          "marker",
          "uplink_marker",
          "downlink_marker"
        ],
        "dlink-webvoice": [
          "open",
          "pulse",
          "close"
        ]
      }
    }
  },
  "rg620-at-console": {
    "description": "Submit custom modem AT commands",
    "write": {
      "ubus": {
        "dlink-cellular": [
          "at_send"
        ]
      }
    }
  }
}
